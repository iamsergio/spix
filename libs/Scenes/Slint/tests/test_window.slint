import { LineEdit, CheckBox, Slider } from "std-widgets.slint";

// Fixed positions, so the tests can check geometry.
export component TestWindow inherits Window {
    width: 400px;
    height: 300px;

    in-out property <int> clicks;
    in-out property <string> last-click;
    in-out property <string> custom: "initial";

    // Two panels with an "ok" button each: lookup must respect nesting
    Rectangle {
        accessible-role: groupbox;
        accessible-id: "panel1";
        x: 0px; y: 0px; width: 200px; height: 100px;
        Rectangle {
            accessible-role: button;
            accessible-id: "ok";
            accessible-label: "OK one";
            x: 10px; y: 10px; width: 50px; height: 30px;
        }
    }
    Rectangle {
        accessible-role: groupbox;
        accessible-id: "panel2";
        x: 200px; y: 0px; width: 200px; height: 100px;
        Rectangle {
            accessible-role: button;
            accessible-id: "ok";
            accessible-label: "OK two";
            x: 10px; y: 10px; width: 50px; height: 30px;
            TouchArea {
                clicked => { root.clicks += 1; }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.up) {
                        root.last-click = (event.button == PointerEventButton.right ? "right" : "left")
                            + (event.modifiers.shift ? "+shift" : "")
                            + (event.modifiers.control ? "+control" : "");
                    }
                }
            }
        }
    }

    // Same id in a repeater
    for i in 3 : Rectangle {
        accessible-role: list-item;
        accessible-id: "row";
        accessible-label: "row " + i;
        x: i * 60px; y: 100px; width: 50px; height: 20px;
    }

    Rectangle {
        accessible-role: button;
        accessible-id: "hidden";
        visible: false;
        x: 0px; y: 120px; width: 10px; height: 10px;
    }
    Text {
        accessible-role: text;
        accessible-id: "label";
        text: "Hello";
        x: 0px; y: 130px;
    }
    LineEdit {
        accessible-id: "edit";
        x: 0px; y: 160px; width: 200px; height: 30px;
    }
    CheckBox {
        accessible-id: "check";
        text: "check me";
        x: 0px; y: 200px;
    }
    Slider {
        accessible-id: "slider";
        minimum: 0;
        maximum: 10;
        value: 5;
        x: 0px; y: 240px; width: 200px; height: 20px;
    }
}
